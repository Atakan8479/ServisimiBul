SPRING_PROFILES_ACTIVE=local
SB_SERVER_PORT=8080
SB_LOG_LEVEL=INFO
SB_COOKIE_SECURE=false
SB_SHUTDOWN_TIMEOUT=30s
# Keep forwarded headers disabled until the exact trusted-proxy topology is reviewed.
SB_FORWARD_HEADERS_STRATEGY=none

# Safe fail-closed default: administrative approval remains required when omitted or true.
OPERATOR_APPROVAL_REQUIRED=true
# Required Istanbul pilot override (set explicitly in that deployment):
# OPERATOR_APPROVAL_REQUIRED=false

SB_DB_JDBC_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
SB_DB_USER=servisimibul_app
SB_DB_PASSWORD=replace-with-a-generated-runtime-password
SB_FLYWAY_ENABLED=false

# Bounded single-instance rate limiter capacity. State resets when the process restarts.
SB_RATE_LIMIT_MAX_KEYS=10000
SB_RATE_LIMIT_OVERFLOW_BUCKETS=1024
SB_RATE_LIMIT_OVERFLOW_MULTIPLIER=4

# Established authentication limits.
SB_RATE_LIMIT_LOGIN_ACCOUNT_REQUESTS=10
SB_RATE_LIMIT_LOGIN_ACCOUNT_WINDOW=15m
SB_RATE_LIMIT_LOGIN_IP_REQUESTS=100
SB_RATE_LIMIT_LOGIN_IP_WINDOW=15m
SB_RATE_LIMIT_REGISTRATION_IP_REQUESTS=20
SB_RATE_LIMIT_REGISTRATION_IP_WINDOW=1h
SB_RATE_LIMIT_VERIFICATION_RESEND_IP_REQUESTS=20
SB_RATE_LIMIT_VERIFICATION_RESEND_IP_WINDOW=1h
SB_RATE_LIMIT_VERIFICATION_RESEND_ACCOUNT_REQUESTS=5
SB_RATE_LIMIT_VERIFICATION_RESEND_ACCOUNT_WINDOW=1h
SB_RATE_LIMIT_PASSWORD_RECOVERY_IP_REQUESTS=20
SB_RATE_LIMIT_PASSWORD_RECOVERY_IP_WINDOW=1h
SB_RATE_LIMIT_PASSWORD_RECOVERY_ACCOUNT_REQUESTS=5
SB_RATE_LIMIT_PASSWORD_RECOVERY_ACCOUNT_WINDOW=1h

# Provisional limits: measure and approve these in staging before production sign-off.
SB_RATE_LIMIT_EMAIL_VERIFICATION_IP_REQUESTS=60
SB_RATE_LIMIT_EMAIL_VERIFICATION_IP_WINDOW=15m
SB_RATE_LIMIT_EMAIL_VERIFICATION_TOKEN_REQUESTS=5
SB_RATE_LIMIT_EMAIL_VERIFICATION_TOKEN_WINDOW=15m
SB_RATE_LIMIT_PASSWORD_RESET_IP_REQUESTS=30
SB_RATE_LIMIT_PASSWORD_RESET_IP_WINDOW=15m
SB_RATE_LIMIT_PASSWORD_RESET_TOKEN_REQUESTS=5
SB_RATE_LIMIT_PASSWORD_RESET_TOKEN_WINDOW=15m
SB_RATE_LIMIT_PUBLIC_SEARCH_IP_REQUESTS=120
SB_RATE_LIMIT_PUBLIC_SEARCH_IP_WINDOW=1m

# Supply these only for a controlled migration run, then remove them from the runtime environment.
SB_DB_MIGRATION_JDBC_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
SB_DB_MIGRATION_USER=postgres
SB_DB_MIGRATION_PASSWORD=replace-with-the-supabase-database-password

# Enable only after configuring a real SMTP account. Never commit its password.
SB_MAIL_ENABLED=false
SB_MAIL_HOST=smtp.example.com
SB_MAIL_PORT=587
SB_MAIL_USERNAME=replace-with-the-smtp-username
SB_MAIL_PASSWORD=replace-with-the-smtp-password
SB_MAIL_FROM=no-reply@example.com
SB_MAIL_SMTP_AUTH=true
SB_MAIL_STARTTLS=true
SB_MAIL_STARTTLS_REQUIRED=true
SB_MAIL_CONNECTION_TIMEOUT_MS=5000
SB_MAIL_READ_TIMEOUT_MS=5000
SB_MAIL_WRITE_TIMEOUT_MS=5000
SB_FRONTEND_BASE_URL=http://localhost:3000

# Backend-only persistent volume for immutable official tariff versions and current.json.
SB_TARIFF_STORAGE_DIR=C:/replace-with-a-persistent-servisimibul-tariff-directory

# Enable these only for the one-shot, non-web admin bootstrap command, then remove the credentials.
SB_ADMIN_BOOTSTRAP_ENABLED=false
SB_ADMIN_1_EMAIL=first-admin@example.com
SB_ADMIN_1_PASSWORD=replace-with-a-unique-admin-password
SB_ADMIN_2_EMAIL=second-admin@example.com
SB_ADMIN_2_PASSWORD=replace-with-another-unique-admin-password
